# ============================================================================
# Katube 2025 - Configuração de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores
# NUNCA commite o arquivo .env (contém tokens sensíveis)
# ============================================================================

# ------------------------------------------------------------------------------
# HuggingFace Token (OBRIGATÓRIO)
# ------------------------------------------------------------------------------
# Obter token: https://huggingface.co/settings/tokens
# Aceitar termos:
#   - https://hf.co/pyannote/speaker-diarization-3.1
#   - https://hf.co/pyannote/segmentation-3.0
HUGGINGFACE_TOKEN=seu_token_aqui

# ------------------------------------------------------------------------------
# Configurações de Áudio
# ------------------------------------------------------------------------------
# Sample rate padrão (Hz)
SAMPLE_RATE=24000

# Duração mínima de segmento (segundos)
SEGMENT_MIN_DURATION=10.0

# Duração máxima de segmento (segundos)
SEGMENT_MAX_DURATION=15.0

# ------------------------------------------------------------------------------
# Filtro MOS (Stage 02)
# ------------------------------------------------------------------------------
# Threshold de qualidade MOS (1.0-5.0)
# Valores recomendados:
#   - 3.0: Alta qualidade (recomendado)
#   - 2.5: Qualidade média
#   - 2.0: Aceita qualidade baixa
MOS_THRESHOLD=2.5

# Criar 3 tiers de qualidade (high/medium/low)
MOS_CREATE_TIERS=true
MOS_HIGH_THRESHOLD=3.0
MOS_MEDIUM_THRESHOLD=2.5

# ------------------------------------------------------------------------------
# Validação de Transcrição (Stage 06)
# ------------------------------------------------------------------------------
# Threshold de similaridade Levenshtein (0.0-1.0)
# Valores recomendados:
#   - 0.75: Rigoroso (recomendado para TTS)
#   - 0.70: Moderado
#   - 0.65: Permissivo
SIMILARITY_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# Recursos e Memória
# ------------------------------------------------------------------------------
# Cache máximo de modelos em MB (padrão: 4096 = 4GB)
# Reduzir se tiver pouca RAM disponível
MAX_CACHE_SIZE_MB=4096

# Habilitar garbage collection agressivo (true/false)
AGGRESSIVE_GC=true

# ------------------------------------------------------------------------------
# Stages Opcionais
# ------------------------------------------------------------------------------
# Habilitar filtro MOS (Stage 02) - recomendado
ENABLE_MOS_FILTER=true

# Habilitar denoiser DeepFilterNet (Stage 07) - opcional
# ATENÇÃO: Aumenta tempo de processamento em ~30%
ENABLE_DENOISER=false

# ------------------------------------------------------------------------------
# Diretórios (Opcional - usa defaults se não definido)
# ------------------------------------------------------------------------------
# Diretório base de saída (padrão: ./output)
# OUTPUT_DIR=/caminho/customizado/output

# Diretório de áudios baixados (padrão: ./audios_baixados)
# AUDIOS_BAIXADOS_DIR=/caminho/customizado/audios

# Diretório de segmentos temporários (padrão: ./temp_segments)
# TEMP_SEGMENTS_DIR=/caminho/customizado/temp

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Arquivo de log (deixe vazio para apenas console)
# LOG_FILE=./logs/katube.log

# ------------------------------------------------------------------------------
# Diarização (Stage 03)
# ------------------------------------------------------------------------------
# Modelo pyannote para diarização
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Número padrão de speakers (pode ser sobrescrito por sessão)
DEFAULT_NUM_SPEAKERS=2

# ------------------------------------------------------------------------------
# STT (Stage 04)
# ------------------------------------------------------------------------------
# Modelo Whisper
WHISPER_MODEL=openai/whisper-large-v3

# Modelo WAV2VEC2
WAV2VEC2_MODEL=facebook/wav2vec2-large-960h-lv60-self

# Idioma de transcrição (padrão: português brasileiro)
STT_LANGUAGE=pt

# ------------------------------------------------------------------------------
# Sox Normalizer (Stage 08)
# ------------------------------------------------------------------------------
# Sample rate alvo para normalização final
SOX_TARGET_SAMPLE_RATE=48000

# Formato de saída (wav, flac, mp3)
SOX_TARGET_FORMAT=flac

# Número de canais (1=mono, 2=stereo)
SOX_TARGET_CHANNELS=1

# Normalizar ganho (true/false)
SOX_NORMALIZE_GAIN=true

# ------------------------------------------------------------------------------
# Dataset (Stage 09)
# ------------------------------------------------------------------------------
# Delimitador CSV (padrão: vírgula)
CSV_DELIMITER=,

# Incluir header no CSV (true/false)
CSV_INCLUDE_HEADER=true

# ------------------------------------------------------------------------------
# Desenvolvimento/Debug
# ------------------------------------------------------------------------------
# Salvar arquivos intermediários (true/false)
# ATENÇÃO: Consome muito espaço em disco
SAVE_INTERMEDIATES=true

# Modo debug (logs verbosos)
DEBUG_MODE=false

# Profiling de performance (true/false)
ENABLE_PROFILING=false
